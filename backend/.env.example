# ==============================================
# EduAdapt Backend Environment Variables
# ==============================================

# Server Port
PORT=5000

# Client Application URL (CORS and email links, e.g. http://localhost:5174 or https://your-frontend.onrender.com)
CLIENT_URL=http://localhost:5174

# MongoDB Connection String (Atlas URI or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eduadapt?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Cloudinary Configuration (For user avatars, covers, logos, and materials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Transactional Email Configuration (For OTPs & Invitations)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=EduAdapt
